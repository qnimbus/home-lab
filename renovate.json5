{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  extends: [
    "config:recommended",    // Sensible defaults: PR limits, grouping minor+patch, etc..
    "docker:enableMajor",    // Also open PRs for major Docker image bumps (Talos, k8s use docker datasource)
    ":dependencyDashboard",  // Maintain a GitHub Issue listing every pending update — your control panel
    ":semanticCommits",      // Conventional commit messages on Renovate's own commits

    // Local presets — split out of what used to be a single 447-line packageRules array.
    // Each is resolved via the GitHub App token this repo's Renovate workflow already holds;
    // resolution always reads from `main`, never from a PR branch — a preset edit only takes
    // effect after merge (this repo's workflow only runs on push-to-main/schedule anyway, so
    // that isn't a new limitation). Validate a preset change via `workflow_dispatch` +
    // `dryRun: true` post-merge, not via a test PR.
    "local>qnimbus/home-lab//.renovate/groups.json5",
    "local>qnimbus/home-lab//.renovate/allowedVersions.json5",
    "local>qnimbus/home-lab//.renovate/autoMerge.json5",
    "local>qnimbus/home-lab//.renovate/semanticCommits.json5",
    "local>qnimbus/home-lab//.renovate/labels.json5",
    "local>qnimbus/home-lab//.renovate/overrides.json5",
    "local>qnimbus/home-lab//.renovate/customManagers.json5",
    "local>qnimbus/home-lab//.renovate/grafanaDashboards.json5",
    "local>qnimbus/home-lab//.renovate/changelogs.json5",
  ],

  dependencyDashboard: true,
  dependencyDashboardTitle: "Renovate Dashboard",

  // Renovate runs every ~6hrs
  prHourlyLimit: 2,       // This setting - if enabled - limits Renovate to a maximum of x PRs opened per hour (or run, in our case)
  prConcurrentLimit: 10,  // This setting - if enabled - limits Renovate to a maximum of x concurrent PRs open at any time

  // Only scan on weekends — avoids noise during the week; change to "at any time" to run continuously
  schedule: ["at any time"],

  // Never touch SOPS-encrypted files — contents are ciphertext, not real versions
  // Devcontainer features use OCI artifact format; Renovate's docker datasource can't query them
  ignorePaths: ["**/*.sops.*", ".devcontainer/**"],

  // Dependencies managed outside Renovate — do not open PRs for these.
  // 1password: distributed via AgileBits' servers, no compatible datasource.
  // talosctl: CLI tool in .mise.toml — must match the running Talos server version; bump manually alongside Talos PRs.
  // etcd: CLI tool in .mise.toml — must match the etcd version bundled with the running Talos release.
  // Note: ghcr.io/siderolabs/installer + kubelet are intentionally NOT ignored — tuppr manages upgrades via
  // TalosUpgrade/KubernetesUpgrade CRDs, and Renovate drives version bumps via separateMinorPatch PRs.
  ignoreDeps: [
    "1password",
    "talosctl",
    "etcd",
  ],

  // ── Manager file-pattern overrides ──────────────────────────────────────────
  // Renovate's built-in managers each have a default set of filename globs they
  // scan. These overrides extend those defaults to cover this repo's structure.

  flux: {
    // Pick up HelmRelease, GitRepository, OCIRepository in kubernetes/
    managerFilePatterns: ["/(^|/)kubernetes/.+\\.ya?ml$/"],
  },
  "helm-values": {
    // Pick up image tags inside helm/values.yaml files
    managerFilePatterns: ["/(^|/)kubernetes/.+\\.ya?ml$/"],
  },
  // No `helmfile:` override here — deliberately. Renovate's built-in helmfile manager ships two
  // default managerFilePatterns: one for a file literally named helmfile.yaml, and one for
  // `**/helmfile.d/*.yaml` — the second is what covers ops/bootstrap/helmfile.d/*.yaml (cilium,
  // coredns, spegel, cert-manager, flux-operator, flux-instance). A prior version of this file set
  // managerFilePatterns to just the first pattern, intending to just restate the default — but
  // managerFilePatterns is non-mergeable, so that silently replaced the whole default array and
  // dropped the helmfile.d match, leaving those 6 releases untracked. See docs/QA.md, "Upgrades
  // (tuppr + Renovate)" for the full story. Don't re-add this override unless you explicitly
  // include the helmfile.d pattern alongside whatever you're adding.
  kubernetes: {
    // Raw Kubernetes manifests (image: fields, etc.)
    managerFilePatterns: ["/(^|/)kubernetes/.+\\.ya?ml$/"],
  },
  kustomize: {
    managerFilePatterns: ["/(^|/)kustomization\\.ya?ml$/"],
  },
}
