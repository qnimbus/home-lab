# talos-worker-02
# ---------------
# Model: Lenovo M920Q #2 (i5-8600T, 64GB, X520-DA2) — pure worker.
# NICs:
#   - e1000e: eno1 (mgmt, single onboard NIC — driver selector is unambiguous here)
#   - ixgbe:  enp1s0f0          14:02:ec:6c:6c:7c  (storage bond)
#   - ixgbe:  enp1s0f1          14:02:ec:6c:6c:7d  (storage bond)
# Disks:
#   - CT1000P310SSD2 (Crucial P310 1TB)   — system disk
#   - CT2000T500SSD8 (Crucial T500 2TB)   — Ceph OSD
---
apiVersion: v1alpha1
kind: HostnameConfig
hostname: talos-worker-02
---
apiVersion: v1alpha1
kind: UnattendedInstallConfig
provisioning:
  diskSelector:
    match: disk.model == "CT1000P310SSD2"
---
apiVersion: v1alpha1
kind: LinkAliasConfig
name: mgmt0
selector:
  match: link.driver == "e1000e"
---
apiVersion: v1alpha1
kind: LinkConfig
name: mgmt0
mtu: 1500
addresses:
  - address: 10.60.0.205/24
routes:
  - gateway: 10.60.0.1
---
# IOT VLAN 30 — see cp-01's file for the rationale.
apiVersion: v1alpha1
kind: VLANConfig
name: eno1.30
vlanID: 30
parent: eno1
mtu: 1500
addresses:
  - address: 10.30.0.205/24
---
apiVersion: v1alpha1
kind: SysctlConfig
params:
  net.ipv6.conf.eno1/30.disable_ipv6: "1"
  # Experimental — see cp-02's file.
  net.core.netdev_budget: "1000"
  net.core.netdev_budget_usecs: "16000"
---
apiVersion: v1alpha1
kind: LinkAliasConfig
name: bond-storage-m0
selector:
  match: mac(link.permanent_addr).startsWith("14:02:ec:6c:6c:7c")
---
apiVersion: v1alpha1
kind: LinkAliasConfig
name: bond-storage-m1
selector:
  match: mac(link.permanent_addr).startsWith("14:02:ec:6c:6c:7d")
---
apiVersion: v1alpha1
kind: BondConfig
name: bond-storage
links:
  - bond-storage-m0
  - bond-storage-m1
bondMode: 802.3ad
lacpRate: fast
miimon: 100
updelay: 200
downdelay: 200
xmitHashPolicy: layer3+4
mtu: 9000
addresses:
  - address: 10.200.0.205/24
---
apiVersion: v1alpha1
kind: VolumeConfig
name: EPHEMERAL
provisioning:
  diskSelector:
    match: system_disk
  maxSize: 120GiB
---
apiVersion: v1alpha1
kind: UserVolumeConfig
name: local-hostpath
provisioning:
  diskSelector:
    match: system_disk
  minSize: 100GiB
  grow: true
---
# Legacy fields — see cp-01's file / cluster.yaml.j2 for why.
machine:
  nodeLabels:
    topology.kubernetes.io/zone: homelab-worker-02
  nodeAnnotations:
    network.rook.io/mon-ip: "10.200.0.205"
