{
  "title": "TrueNAS CPU",
  "uid": "truenas-cpu",
  "description": "Clock speed, load, temperature and power of the NAS CPU. The NAS has no throttle counters (AMD) or fan sensors, so sustained clocks below the cap while busy and hot are the throttling signal.",
  "editable": false,
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": ["truenas", "nas"],
  "time": { "from": "now-24h", "to": "now" },
  "timezone": "browser",
  "panels": [
    {
      "type": "timeseries",
      "title": "Clock speed",
      "description": "Max and average current clock over all cores, against the cpufreq limit (scaling_max_freq, set by the boost-cap Post-Init script) and the hardware maximum (cpuinfo_max_freq).",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "hertz", "min": 0, "custom": { "fillOpacity": 0 } },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "Limit|Hardware max" },
            "properties": [
              { "id": "custom.lineStyle", "value": { "dash": [10, 10], "fill": "dash" } }
            ]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(node_cpu_scaling_frequency_hertz{instance=\"truenas\"})",
          "legendFormat": "Max"
        },
        {
          "refId": "B",
          "expr": "avg(node_cpu_scaling_frequency_hertz{instance=\"truenas\"})",
          "legendFormat": "Average"
        },
        {
          "refId": "C",
          "expr": "max(node_cpu_scaling_frequency_max_hertz{instance=\"truenas\"})",
          "legendFormat": "Limit"
        },
        {
          "refId": "D",
          "expr": "max(node_cpu_frequency_max_hertz{instance=\"truenas\"})",
          "legendFormat": "Hardware max"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "CPU utilisation",
      "description": "Share of CPU time not idle, averaged over all cores, and the busiest core.",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1, "custom": { "fillOpacity": 10 } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - avg(rate(node_cpu_seconds_total{instance=\"truenas\", mode=\"idle\"}[$__rate_interval]))",
          "legendFormat": "Average"
        },
        {
          "refId": "B",
          "expr": "1 - min(rate(node_cpu_seconds_total{instance=\"truenas\", mode=\"idle\"}[$__rate_interval]))",
          "legendFormat": "Busiest core"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "CPU temperature (Tctl)",
      "description": "k10temp Tctl, which reads about 10°C above the die. NodeCpuTemperatureWarning fires above 80°C, Critical above 90°C.",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "min": 20,
          "max": 100,
          "custom": { "fillOpacity": 0, "thresholdsStyle": { "mode": "line+area" } },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "transparent", "value": null },
              { "color": "orange", "value": 80 },
              { "color": "red", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_hwmon_temp_celsius{instance=\"truenas\", chip=\"pci0000:00_0000:00:18_3\", sensor=\"temp1\"}",
          "legendFormat": "Tctl"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "CPU power (RAPL)",
      "description": "Package and core power from the RAPL energy counters. Needs the NAS Post-Init chmod that makes energy_uj readable to node-exporter; empty without it.",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "watt", "min": 0, "custom": { "fillOpacity": 10 } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(node_rapl_package_joules_total{instance=\"truenas\"}[$__rate_interval]))",
          "legendFormat": "Package"
        },
        {
          "refId": "B",
          "expr": "sum(rate(node_rapl_core_joules_total{instance=\"truenas\"}[$__rate_interval]))",
          "legendFormat": "Cores"
        }
      ]
    }
  ]
}
