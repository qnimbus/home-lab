DOMAIN_CASA=example.casa
DOMAIN_CLUSTER=cluster.example.io
DOMAIN_IO=example.io
DOMAIN_PROXII=example.net
DOMAIN_TAILSCALE=example.ts.net
HOME_ASSISTANT_LAN_HOST=192.0.2.10
LAN_CIDR=192.0.2.0/24
LB_IP_PLEX=192.0.2.20
LB_IP_PLEX_IOT=198.51.100.20
MAIL_FROM_ADDRESS=noreply@example.io
NAS_HOST=198.51.100.41
