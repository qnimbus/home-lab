# Placeholder values for Flux postBuild substitution, used by validate.yaml so
# ${VAR} references render to schema-valid hostnames/IPs before validation.
# Not the real values — those live in kubernetes/components/cluster-settings/
# (plus per-app ExternalSecrets for CLOUDFLARE_TUNNEL_ID and TAILSCALE_USER).
# Add any new variable that lands in a pattern-validated field (hostnames, IPs,
# CIDRs, resource names). Variables with a ${VAR:=default} in
# the manifests don't need an entry.
APP=app
CLOUDFLARE_TUNNEL_ID=00000000-0000-0000-0000-000000000000
CLUSTER_TIMEZONE=Europe/Amsterdam
DOMAIN_APP=example.app
