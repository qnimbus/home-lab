{{- /* Chart + version come from the app's own Flux manifests, so Renovate bumps one place. */ -}}
{{- $app := printf "../../../kubernetes/apps/%s/%s/app" .Release.Namespace .Release.Name -}}
{{- $oci := readFile (printf "%s/ocirepository.yaml" $app) | fromYaml -}}
chart: {{ $oci.spec.url }}
version: {{ $oci.spec.ref.tag }}
