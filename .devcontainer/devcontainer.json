{
  "name": "Python 3 Development Container",
  "image": "mcr.microsoft.com/devcontainers/python:latest",

  "containerUser": "vscode",

  "features": {
    "ghcr.io/devcontainers/features/git:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/node": {
      "version": "latest"
    }
  },
  "postCreateCommand": "bash .devcontainer/postCreateCommand.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "blueglassblock.better-json5",
        "irongeek.vscode-env",
        "redhat.vscode-yaml",
        "signageos.signageos-vscode-sops",
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "anthropic.claude-code"
      ],
      "settings": {
        "files.eol": "\n",
        "files.insertFinalNewline": true,
        "editor.bracketPairColorization.enabled": true,
        "files.associations": {
          "**/*.json5": "json5"
        },
        "files.trimTrailingWhitespace": true,
        "sops.defaults.ageKeyFile": "age.key",
        "vs-kubernetes": {
          "vs-kubernetes.kubeconfig": "./kubeconfig",
          "vs-kubernetes.knownKubeconfigs": ["./kubeconfig"]
        },
        "yaml.schemaStore.enable": true,
        "yaml.schemas": {
          "kubernetes": "./kubernetes/**/*.yaml"
        }
      }
    }
  },
  "remoteEnv": {
    "SOPS_AGE_KEY_FILE": "${containerWorkspaceFolder}/age.key",
    "KUBECONFIG": "${containerWorkspaceFolder}/kubeconfig",
    "TALOSCONFIG": "${containerWorkspaceFolder}/talos/clusterconfig/talosconfig",
    "OP_SERVICE_ACCOUNT_TOKEN": "${localEnv:OP_SERVICE_ACCOUNT_TOKEN}",
    "GH_TOKEN": "${localEnv:GH_TOKEN}"
  },
  "forwardPorts": [],
  "mounts": [
    "source=claude-home,target=/home/vscode/.claude,type=volume",
    "source=home-local,target=/home/vscode/.local,type=volume",
    "source=home-kub,target=/home/vscode/.kube,type=volume"
  ]
}
