{
  "permissions": {
    "allow": [
      "Skill(update-config)",
      "Skill(update-config:*)",
      "Read(//home/vscode/**)",
      "WebSearch",
      "WebFetch(domain:hub.docker.com)",
      "WebFetch(domain:developer.1password.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:1password.community)",
      "WebFetch(domain:blog.gripdev.xyz)",
      "WebFetch(domain:external-secrets.io)",
      "WebFetch(domain:blog.cyberwatchdoug.com)",
      "WebFetch(domain:andreivasiliu.com)",
      "WebFetch(domain:budimanjojo.github.io)",
      "WebFetch(domain:paulocurado.com)",
      "WebFetch(domain:mcjones.ca)",
      "WebFetch(domain:www.talos.dev)",
      "WebFetch(domain:doc.siderolabs.com)",
      "mcp__kubernetes-mcp-server__resources_list",
      "mcp__kubernetes-mcp-server__events_list",
      "mcp__kubernetes-mcp-server__namespaces_list",
      "mcp__kubernetes-mcp-server__resources_get",
      "mcp__kubernetes-mcp-server__pods_log",
      "mcp__kubernetes-mcp-server__pods_list_in_namespace",
      "mcp__kubernetes-mcp-server__pods_list",
      "mcp__kubernetes-mcp-server__nodes_top",
      "mcp__kubernetes-mcp-server__nodes_log",
      "mcp__kubernetes-mcp-server__nodes_stats_summary",
      "mcp__kubernetes-mcp-server__pods_get",
      "mcp__kubernetes-mcp-server__pods_top",
      "mcp__context7__resolve-library-id",
      "mcp__context7__query-docs",
      "mcp__github__get_file_contents",
      "mcp__github__pull_request_read",
      "mcp__github__get_release_by_tag",
      "mcp__github__list_releases",
      "Bash(task --list)",
      "Bash(task talos:iso)",
      "Bash(task talos:genconfig *)",
      "Bash(task reconcile *)",
      "Bash(/workspaces/home-lab/scripts/mcp.sh renew-token *)",
      "Bash(/workspaces/home-lab/scripts/mcp.sh setup *)",
      "Bash(talosctl *)",
      "Bash(kubectl get *)",
      "Bash(kubectl describe *)",
      "Bash(kubectl logs *)",
      "Bash(kubectl top *)",
      "Bash(kubectl wait *)",
      "Bash(kubectl -n flux-system get *)",
      "Bash(kubectl -n observability get *)",
      "Bash(kubectl -n network get *)",
      "Bash(KUBECONFIG=/workspaces/home-lab/kubeconfig kubectl *)",
      "Bash(KUBECONFIG=$(pwd)/kubeconfig kubectl *)",
      "Bash(kubectl --kubeconfig /workspaces/home-lab/kubeconfig *)",
      "Bash(flux get *)",
      "Bash(flux reconcile *)",
      "Bash(curl *)",
      "Bash(gh api *)",
      "Bash(gh release *)",
      "Bash(yq e *)",
      "Bash(sops --decrypt *)",
      "Bash(helm list *)",
      "Bash(helm history *)",
      "Bash(helm show *)",
      "Bash(KUBECONFIG=/workspaces/home-lab/kubeconfig helm list *)",
      "Bash(KUBECONFIG=/workspaces/home-lab/kubeconfig helm history *)",
      "Bash(claude mcp *)",
      "Bash(talhelper genconfig *)",
      "Bash(talhelper --version)",
      "Bash(python3 -m json.tool)",
      "Bash(xargs ls -l*)",
      "Bash(xargs cat)",
      "Bash(awk *)",
      "Bash(bash /workspaces/home-lab/scripts/mcp.sh)",
      "Bash(/usr/local/share/nvm/current/bin/node /usr/local/share/nvm/current/lib/node_modules/npm/bin/npx-cli.js -y @upstash/context7-mcp)",
      "Bash(git *)"
    ],
    "deny": [
      "Bash(git push *)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "context7"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash /workspaces/home-lab/.claude/hooks/check-sops.sh",
            "statusMessage": "Checking SOPS encryption..."
          },
          {
            "type": "command",
            "command": "bash /workspaces/home-lab/.claude/hooks/check-shell-injection.sh",
            "statusMessage": "Checking for unsafe patterns..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash /workspaces/home-lab/.claude/hooks/check-secret-output.sh",
            "statusMessage": "Scanning output for secrets..."
          }
        ]
      }
    ]
  },
  "outputStyle": "Explanatory"
}
