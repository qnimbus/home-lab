{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash /workspaces/home-lab/.claude/hooks/check-sops.sh",
            "statusMessage": "Checking SOPS encryption..."
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Skill(update-config)",
      "Skill(update-config:*)",
      "Read(//home/vscode/**)",
      "WebSearch",
      "WebFetch(domain:hub.docker.com)",
      "WebFetch(domain:developer.1password.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:1password.community)",
      "WebFetch(domain:blog.gripdev.xyz)",
      "WebFetch(domain:external-secrets.io)",
      "WebFetch(domain:blog.cyberwatchdoug.com)",
      "WebFetch(domain:andreivasiliu.com)",
      "WebFetch(domain:budimanjojo.github.io)",
      "WebFetch(domain:paulocurado.com)",
      "WebFetch(domain:mcjones.ca)",
      "WebFetch(domain:www.talos.dev)",
      "WebFetch(domain:doc.siderolabs.com)",
      "mcp__kubernetes-mcp-server__resources_list",
      "mcp__kubernetes-mcp-server__events_list",
      "mcp__kubernetes-mcp-server__namespaces_list",
      "mcp__kubernetes-mcp-server__resources_get",
      "mcp__kubernetes-mcp-server__pods_log",
      "mcp__kubernetes-mcp-server__pods_list_in_namespace",
      "mcp__kubernetes-mcp-server__pods_list",
      "mcp__context7__resolve-library-id",
      "mcp__context7__query-docs",
      "Bash(task --list)",
      "Bash(task talos:iso)",
      "Bash(task talos:genconfig *)",
      "Bash(task reconcile *)",
      "Bash(/workspaces/home-lab/scripts/mcp.sh renew-token *)",
      "Bash(/workspaces/home-lab/scripts/mcp.sh setup *)",
      "Bash(talosctl *)",
      "Bash(talosctl get *)",
      "Bash(kubectl get *)",
      "Bash(flux get *)",
      "Bash(flux reconcile *)",
      "Bash(xargs ls -la)",
      "Bash(git -C /workspaces/home-lab remote -v)",
      "Bash(gh api *)",
      "Bash(gh release *)",
      "Bash(claude mcp *)",
      "Bash(/usr/local/share/nvm/current/bin/node /usr/local/share/nvm/current/lib/node_modules/npm/bin/npx-cli.js -y @upstash/context7-mcp)",
      "Bash(echo \"Exit: $?\")",
      "Bash(xargs cat)",
      "Bash(talosctl version *)",
      "Bash(talhelper --version)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "context7"
  ],
  "outputStyle": "Explanatory"
}
