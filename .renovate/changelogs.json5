{
  // Explicit changelogUrl overrides for packages where Renovate's automatic
  // source-repo detection doesn't land on the most useful page (either resolves to
  // the wrong repo entirely, or to a GitHub Releases tab that's sparser than the
  // project's own changelog file). Pattern borrowed from bykaj/home-ops.

  packageRules: [
    {
      // This repo tracks the official `connect` Helm chart (1password.github.io/connect-helm-charts),
      // not an image named "1password/..." — depName is the bare chart name "connect", so the
      // upstream repo's own /1password/ substring match (used when the chart is deployed via
      // app-template with explicit ghcr.io/1password/connect-* image refs) wouldn't match here.
      description: "Changelog URL for 1Password Connect",
      matchDatasources: ["helm"],
      matchPackageNames: ["connect"],
      changelogUrl: "https://github.com/1Password/connect/blob/main/CHANGELOG.md",
    },
    {
      description: "Changelog URL for Cloudflared",
      matchPackageNames: ["/cloudflared/"],
      changelogUrl: "https://github.com/cloudflare/cloudflared/blob/master/RELEASE_NOTES",
    },
    {
      description: "Changelog URL for Spegel",
      matchPackageNames: ["/spegel/"],
      changelogUrl: "https://github.com/spegel-org/spegel/blob/main/CHANGELOG.md",
    },
  ],
}
