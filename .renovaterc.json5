{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'github>home-operations/renovate-presets#11.0.0',
    'github>home-operations/renovate-presets//apps/cnpg.json5#11.0.0',
    'github>home-operations/renovate-presets//apps/grafanaDashboards.json5#11.0.0',
    'github>home-operations/renovate-presets//apps/talosFactory.json5#11.0.0',
    ':timezone(Europe/Amsterdam)',
  ],
  dependencyDashboard: {
    title: 'Renovate Dashboard for my home-lab 🤖',
  },
  lockFileMaintenance: {
    enabled: true,
    schedule: [
      'before 3am on the first day of the month',
    ],
    commitMessageExtra: '({{manager}})',
    additionalBranchPrefix: '{{manager}}-',
  },
  rebaseWhen: 'conflicted',
  ignoreDeps: [
    'etcd',
  ],
  logLevelRemap: [
    {
      matchMessage: "/Some .+ did not have a releaseTimestamp, but as we're running with minimumReleaseAgeBehaviour=timestamp-optional, proceeding/",
      newLogLevel: 'info',
    },
  ],
  packageRules: [
    {
      description: 'Keep Ceph on stable 20.2.x (Tentacle)',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'quay.io/ceph/ceph',
      ],
      allowedVersions: '/^v?20\\.2\\.\\d+$/',
    },
    {
      description: 'Keep ceph-csi-drivers at the ceph-csi-operator Rook bundles',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'ghcr.io/home-operations/charts-mirror/ceph-csi-drivers',
      ],
      allowedVersions: '<=1.1.0',
    },
    {
      description: 'Keep PostgreSQL on version 18.x',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        '/postgresql/',
      ],
      allowedVersions: '<19',
    },
    {
      description: 'Keep Sonarr on version 4.x',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'ghcr.io/home-operations/sonarr',
      ],
      allowedVersions: '<5',
    },
    {
      description: 'Keep Gotenberg on version 8.x',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'docker.io/gotenberg/gotenberg',
      ],
      allowedVersions: '<9',
    },
    {
      description: 'Keep the mise Python on 3.14.x',
      matchManagers: [
        'mise',
      ],
      matchDepNames: [
        'python',
      ],
      allowedVersions: '<3.15',
    },
    {
      description: 'WAHA: parse the version from the gows-YYYY.M.P tag',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'docker.io/devlikeapro/waha',
      ],
      versioning: 'regex:^gows-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$',
    },
    {
      description: 'nut-upsd: the -rN suffix is the Alpine package release',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'docker.io/instantlinux/nut-upsd',
      ],
      versioning: 'regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-r(?<build>\\d+)$',
    },
    {
      description: 'llama.cpp: parse the build number from the server-vulkan-bNNNN tag',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'ghcr.io/ggml-org/llama.cpp',
      ],
      versioning: 'regex:^server-vulkan-b(?<major>\\d+)$',
    },
    {
      description: 'Auto-merge trusted OCI digests',
      matchDatasources: [
        'docker',
      ],
      matchUpdateTypes: [
        'digest',
      ],
      automerge: true,
      automergeType: 'pr',
      ignoreTests: false,
      matchPackageNames: [
        '/bjw-s/{/,}**',
        '/bjw-s-labs/{/,}**',
        '/qnimbus/{/,}**',
        '/home-operations/{/,}**',
        '/onedr0p/{/,}**',
      ],
    },
    {
      description: 'Auto-merge high-cadence OCI packages weekly',
      matchDatasources: [
        'docker',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      matchPackageNames: [
        '/kube-prometheus-stack/',
      ],
      automerge: true,
      automergeType: 'pr',
      ignoreTests: false,
      schedule: [
        'before 6am on Monday',
      ],
    },
    {
      description: 'Auto-merge CNPG PostgreSQL digests weekly',
      matchDatasources: [
        'docker',
      ],
      matchUpdateTypes: [
        'digest',
      ],
      matchPackageNames: [
        'ghcr.io/cloudnative-pg/postgresql',
      ],
      automerge: true,
      automergeType: 'pr',
      ignoreTests: false,
      automergeSchedule: [
        'after 6am and before 10am on Monday',
      ],
    },
    {
      description: 'Auto-merge Traefik digests',
      matchDatasources: [
        'docker',
      ],
      matchUpdateTypes: [
        'digest',
      ],
      matchPackageNames: [
        'traefik',
      ],
      automerge: true,
      automergeType: 'pr',
      ignoreTests: false,
      minimumReleaseAge: '1 day',
    },
    {
      description: 'Auto-merge patch updates for media and downloads apps',
      matchFileNames: [
        'kubernetes/apps/downloads/**',
        'kubernetes/apps/media/**',
      ],
      matchDatasources: [
        'docker',
      ],
      matchUpdateTypes: [
        'patch',
      ],
      matchPackageNames: [
        'ghcr.io/home-operations/plex',
        'ghcr.io/home-operations/prowlarr',
        'ghcr.io/home-operations/radarr',
        'ghcr.io/raydak-labs/configarr',
        'ghcr.io/home-operations/sonarr',
        'ghcr.io/home-operations/sabnzbd',
      ],
      automerge: true,
      automergeType: 'pr',
      ignoreTests: false,
      minimumReleaseAge: '1 day',
      minimumReleaseAgeBehaviour: 'timestamp-optional',
    },
    {
      description: 'Auto-merge GitHub Actions',
      matchManagers: [
        'github-actions',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
        'digest',
      ],
      automerge: true,
      automergeType: 'branch',
      minimumReleaseAge: '3 days',
      ignoreTests: true,
    },
    {
      description: 'Auto-merge trusted GitHub Actions',
      matchManagers: [
        'github-actions',
      ],
      matchPackageNames: [
        '/^actions\\//',
        '/^renovatebot\\//',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
        'digest',
      ],
      automerge: true,
      automergeType: 'branch',
      minimumReleaseAge: '1 minute',
      ignoreTests: true,
    },
    {
      description: 'Auto-merge Grafana dashboards',
      matchDatasources: [
        'custom.grafana-dashboards',
      ],
      matchUpdateTypes: [
        'major',
      ],
      automerge: true,
      automergeType: 'branch',
      ignoreTests: true,
    },
    {
      description: 'Auto-merge Renovate Presets',
      matchManagers: [
        'renovate-config',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      automerge: true,
      automergeType: 'branch',
      ignoreTests: true,
    },
    {
      description: 'Actions Runner Controller Group',
      groupName: 'actions-runner-controller',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        '/gha-runner-scale-set-controller/',
        '/gha-runner-scale-set/',
      ],
      group: {
        commitMessageTopic: '{{{groupName}}} group',
      },
      minimumGroupSize: 2,
    },
    {
      description: 'Flux Operator Group',
      groupName: 'flux-operator',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        '/flux-operator/',
        '/flux-instance/',
      ],
      group: {
        commitMessageTopic: '{{{groupName}}} group',
      },
      minimumGroupSize: 2,
    },
    {
      description: 'Kubernetes Group',
      groupName: 'kubernetes',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        '/kube-apiserver/',
        '/kube-controller-manager/',
        '/kube-proxy/',
        '/kube-scheduler/',
        '/kubelet/',
      ],
      group: {
        commitMessageTopic: '{{{groupName}}} group',
      },
      minimumGroupSize: 2,
    },
    {
      description: 'Mise Tools Group',
      matchManagers: [
        'mise',
      ],
      matchDepNames: [
        '!node',
        '!oxfmt',
      ],
      groupName: 'mise tools',
      groupSlug: 'mise-tools',
    },
    {
      description: 'n8n Group',
      groupName: 'n8n',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'ghcr.io/n8n-io/n8n',
        'ghcr.io/n8n-io/runners',
      ],
      group: {
        commitMessageTopic: '{{{groupName}}} group',
      },
      minimumGroupSize: 2,
    },
    {
      description: 'Renovate Group',
      groupName: 'renovate',
      matchDatasources: [
        'docker',
        'npm',
      ],
      matchPackageNames: [
        'ghcr.io/renovatebot/renovate',
        'renovate',
      ],
      group: {
        commitMessageTopic: '{{{groupName}}} group',
      },
      minimumGroupSize: 2,
      minimumReleaseAge: null,
      automerge: true,
      automergeType: 'branch',
      ignoreTests: true,
    },
    {
      description: 'Rook-Ceph Group',
      groupName: 'rook-ceph',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        '/rook-ceph/',
        '/rook-ceph-cluster/',
      ],
      group: {
        commitMessageTopic: '{{{groupName}}} group',
      },
      minimumGroupSize: 2,
    },
    {
      description: 'Talos Group',
      groupName: 'talos',
      matchPackageNames: [
        'siderolabs/talos',
      ],
      group: {
        commitMessageTopic: '{{{groupName}}} group',
      },
      minimumGroupSize: 2,
    },
    {
      description: 'Write the dependency locks of the mise pypi tools',
      matchManagers: [
        'mise',
      ],
      postUpgradeTasks: {
        commands: [
          'env MISE_SAFE=1 mise lock yamllint pypi:ansible pypi:ansible-core',
        ],
        executionMode: 'branch',
        fileFilters: [
          '.mise/**',
        ],
        installTools: {
          mise: {},
          python: {},
          uv: {},
        },
      },
    },
    {
      description: 'Hold the mise pypi tools for a day',
      matchManagers: [
        'mise',
      ],
      matchDepNames: [
        '/^pypi:/',
        'yamllint',
      ],
      minimumReleaseAge: '1 day',
    },
    {
      description: 'High-cadence mise tools monthly',
      matchManagers: [
        'mise',
      ],
      matchDepNames: [
        'node',
        'oxfmt',
      ],
      schedule: [
        'before 3am on the first day of the month',
      ],
    },
    {
      matchUpdateTypes: [
        'major',
      ],
      addLabels: [
        'type/major',
      ],
    },
    {
      matchUpdateTypes: [
        'minor',
      ],
      addLabels: [
        'type/minor',
      ],
    },
    {
      matchUpdateTypes: [
        'patch',
      ],
      addLabels: [
        'type/patch',
      ],
    },
    {
      matchUpdateTypes: [
        'digest',
      ],
      addLabels: [
        'type/digest',
      ],
    },
  ],
}
